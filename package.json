{
  "name": "pricetool",
  "version": "2.3.0",
  "description": "Multi-source Steam Wishlist & Deals Intelligence Engine",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite src/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build src/client --outDir ../../dist/client",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "test:client": "vitest run --project client",
    "test:server": "vitest run --project server --fileParallelism=false",
    "test:sources": "tsx scripts/test-sources.ts",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.4",
    "lucide-react": "^0.475.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
