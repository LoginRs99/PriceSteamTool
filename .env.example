# ==============================================================================
# PriceTool Configuration (.env)
# ==============================================================================

# Server & Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
DATA_DIR=/data

# Cache & Background Sync Settings
CACHE_TTL_HOURS=6
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=6
HISTORY_RETENTION_DAYS=365

# External API Keys (Optional - enhances official & aggregated store coverage)
STEAM_API_KEY=
ITAD_API_KEY=
GGDEALS_API_KEY=

# Core Sync Pacing & Delays (Milliseconds)
STEAM_DELAY_MS=1500
ITAD_DELAY_MS=500
CHEAPSHARK_DELAY_MS=500
GGDEALS_DELAY_MS=1000

# Background Keyshop Enrichment (AllKeyShop - requires Byparr or FlareSolverr solver)
ALLKEYSHOP_SOLVER_URL= # Byparr or FlareSolverr URL (e.g. http://localhost:8191 or http://flaresolverr:8191). Requires a solver — no direct-scraping fallback.
ALLKEYSHOP_MAX_GAMES=100 # Default cap per enrichment run (0 = unlimited)
ALLKEYSHOP_DELAY_MS=2000
ALLKEYSHOP_JITTER_MS=1000
ALLKEYSHOP_CHUNK_SIZE=100
ALLKEYSHOP_CHUNK_PAUSE_MS=10000

# Discord Deal Alert Webhook (Optional - can also be configured via Web UI)
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=false
DISCORD_MIN_DEAL_SCORE=75
DISCORD_MIN_CONFIDENCE=40
DISCORD_NOTIFY_ATL_ONLY=false
DISCORD_NOTIFY_FREE_GAMES=true
DISCORD_COOLDOWN_HOURS=24

# Security & Access Control (Optional)
# TRUSTED_ORIGINS=http://localhost:5173,http://192.168.1.100:3000 # Allowed CORS origins (comma-separated). If unset, allows all (*).
# API_TOKEN=your-secret-api-token # Shared-secret token required via X-API-Token header for API requests (UI & public health excluded).
