# ==============================================================================
# PriceTool Configuration (.env)
# Re-optimized for stealth, anti-bot protection & accurate store sync cycles
# ==============================================================================

# Server & Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
DATA_DIR=/data

# Cache & Background Sync Settings
# Video game discounts rotate once (19:00 CET on Steam) or twice daily on storefronts.
# 12h = optimal balance (catches all promotions without wasting requests).
# 24h = maximum stealth & minimum resource usage.
CACHE_TTL_HOURS=12
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=12
HISTORY_RETENTION_DAYS=365

# External API Keys (Optional - enhances official & aggregated store coverage)
STEAM_API_KEY=
ITAD_API_KEY=
GGDEALS_API_KEY=

# Core Sync Pacing & Delays (Milliseconds)
# Polite pacing prevents HTTP 429 rate limits and Cloudflare captchas
STEAM_DELAY_MS=2000              # Steam storefront rate-limit buffer (2.0s per batch)
ITAD_DELAY_MS=1000               # IsThereAnyDeal official batch API (150-200 items/req)
CHEAPSHARK_DELAY_MS=1500         # CheapShark chunked batching (25 AppIDs/req)
CHEAPSHARK_CHUNK_PAUSE_MS=3000   # 3s rest between CheapShark 25-game chunks
GGDEALS_DELAY_MS=2000            # Aggressive bot detection defense
GGDEALS_CHUNK_PAUSE_MS=60000     # 60s cooldown if scraping large GGDeals lists

# Background Keyshop Enrichment (AllKeyShop - requires Byparr or FlareSolverr solver)
ALLKEYSHOP_SOLVER_URL=           # Byparr / FlareSolverr URL (e.g. http://localhost:8191 or http://flaresolverr:8191)
ALLKEYSHOP_MAX_GAMES=250         # Priority games per enrichment run (0 = unlimited). 250 keeps solver memory safe.
ALLKEYSHOP_DELAY_MS=3000         # 3.0s base delay between solver calls
ALLKEYSHOP_JITTER_MS=1500        # Random variation (delays range between 3.0s and 4.5s for human-like traffic)
ALLKEYSHOP_CHUNK_SIZE=50         # Process in batches of 50 games
ALLKEYSHOP_CHUNK_PAUSE_MS=30000  # 30s pause after each chunk of 50 to cool down solver and Cloudflare session

# Discord Deal Alert Webhook (Optional - can also be configured via Web UI)
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=false
DISCORD_MIN_DEAL_SCORE=75
DISCORD_MIN_CONFIDENCE=40
DISCORD_NOTIFY_ATL_ONLY=false
DISCORD_NOTIFY_FREE_GAMES=true
DISCORD_NOTIFY_PRICING_ERRORS=true
DISCORD_COOLDOWN_HOURS=24

# Security & Access Control (Optional)
# TRUSTED_ORIGINS=http://localhost:5173,http://192.168.1.100:3000 # Allowed CORS origins (comma-separated).
# API_TOKEN=your-secret-api-token # Shared-secret token required via X-API-Token header.
# TRUST_PROXY=false # Set to true if deployed behind reverse proxy (Nginx, Traefik, Caddy)
# V1_RATE_LIMIT_PER_MIN=300 # Max requests per minute per IP on /api/v1/ routes
