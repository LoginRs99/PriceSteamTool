# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
DATA_DIR=/data
# Cache & Periodic Auto-Sync settings
CACHE_TTL_HOURS=6
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=6

# External API Keys (Optional - enhances coverage)
STEAM_API_KEY=
ITAD_API_KEY=
GGDEALS_API_KEY=

# Source Rate Limiting & Pacing (Milliseconds)
STEAM_DELAY_MS=1000
ITAD_DELAY_MS=500
CHEAPSHARK_DELAY_MS=500
GGDEALS_DELAY_MS=1000
ALLKEYSHOP_DELAY_MS=2500
GOCDKEYS_DELAY_MS=4000
